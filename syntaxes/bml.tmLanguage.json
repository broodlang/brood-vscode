{
  "scopeName": "source.bml",
  "name": "BML",
  "patterns": [
    { "include": "#comment" },
    { "include": "#style-element" },
    { "include": "#script-element" },
    { "include": "#component" },
    { "include": "#interpolation" },
    { "include": "#tag" }
  ],
  "repository": {
    "comment": {
      "name": "comment.block.bml",
      "begin": "<!--",
      "end": "-->"
    },
    "style-element": {
      "comment": "Raw-text <style>: content is CSS, not markup — no interpolation.",
      "begin": "(<)(style)\\b",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.bml" },
        "2": { "name": "entity.name.tag.bml" }
      },
      "end": "(</)(style)\\s*(>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.bml" },
        "2": { "name": "entity.name.tag.bml" },
        "3": { "name": "punctuation.definition.tag.end.bml" }
      },
      "patterns": [
        { "begin": ">", "end": "(?=</style)", "patterns": [{ "include": "source.css" }] },
        { "include": "#attribute" }
      ]
    },
    "script-element": {
      "comment": "Raw-text <script>: content is JS, not markup — no interpolation.",
      "begin": "(<)(script)\\b",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.bml" },
        "2": { "name": "entity.name.tag.bml" }
      },
      "end": "(</)(script)\\s*(>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.bml" },
        "2": { "name": "entity.name.tag.bml" },
        "3": { "name": "punctuation.definition.tag.end.bml" }
      },
      "patterns": [
        { "begin": ">", "end": "(?=</script)", "patterns": [{ "include": "source.js" }] },
        { "include": "#attribute" }
      ]
    },
    "component": {
      "comment": "Component tags <.name …>/</.name> compile to function calls.",
      "begin": "(</?\\.)([a-zA-Z][a-zA-Z0-9/_-]*)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.bml" },
        "2": { "name": "entity.name.type.component.bml" }
      },
      "end": "(/?>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.end.bml" }
      },
      "patterns": [
        { "include": "#attribute" }
      ]
    },
    "assign": {
      "comment": "@name — BML shorthand for (get model :name); a Brood symbol the brood grammar leaves unscoped, so highlight it here.",
      "match": "@[A-Za-z_][A-Za-z0-9_?!-]*",
      "name": "variable.language.assign.bml"
    },
    "interpolation": {
      "name": "meta.embedded.brood.bml",
      "begin": "\\{",
      "beginCaptures": {
        "0": { "name": "punctuation.section.interpolation.begin.bml" }
      },
      "end": "\\}",
      "endCaptures": {
        "0": { "name": "punctuation.section.interpolation.end.bml" }
      },
      "patterns": [
        { "include": "#assign" },
        { "include": "#nested-braces" },
        { "include": "source.brood" }
      ]
    },
    "nested-braces": {
      "comment": "A Brood map literal inside an interpolation — consume its own braces so the outer interpolation isn't closed early.",
      "begin": "\\{",
      "end": "\\}",
      "patterns": [
        { "include": "#assign" },
        { "include": "#nested-braces" },
        { "include": "source.brood" }
      ]
    },
    "tag": {
      "begin": "(</?)([a-zA-Z][a-zA-Z0-9-]*)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.bml" },
        "2": { "name": "entity.name.tag.bml" }
      },
      "end": "(/?>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.end.bml" }
      },
      "patterns": [
        { "include": "#attribute" }
      ]
    },
    "attribute": {
      "patterns": [
        {
          "name": "keyword.control.directive.bml",
          "match": ":(?:if|for)(?=\\s*=)"
        },
        {
          "name": "entity.other.attribute-name.bml",
          "match": "[a-zA-Z_:][a-zA-Z0-9_:.-]*"
        },
        { "include": "#string" },
        { "include": "#interpolation" }
      ]
    },
    "string": {
      "name": "string.quoted.double.bml",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "include": "#interpolation" }
      ]
    }
  }
}
