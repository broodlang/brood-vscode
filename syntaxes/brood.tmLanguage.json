{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Brood",
  "scopeName": "source.brood",
  "patterns": [
    { "include": "#comment" },
    { "include": "#string" },
    { "include": "#definition" },
    { "include": "#special-form" },
    { "include": "#threading" },
    { "include": "#param-marker" },
    { "include": "#constant" },
    { "include": "#keyword" },
    { "include": "#number" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.semicolon.brood",
      "match": ";.*$"
    },
    "string": {
      "name": "string.quoted.double.brood",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.brood", "match": "\\\\." }
      ]
    },
    "definition": {
      "comment": "Any def… head — (def NAME), (defn NAME), (defmacro/defmodule/defdyn/deftest NAME) — colouring the head as a keyword and the defined name.",
      "match": "(?<=\\()(def[^\\s()\\[\\]{}\",'`;]*)(\\s+([^\\s()\\[\\]{}\",'`;]+))?",
      "captures": {
        "1": { "name": "keyword.declaration.brood" },
        "3": { "name": "entity.name.function.brood" }
      }
    },
    "special-form": {
      "comment": "The 11 evaluator special forms plus the core control/binding/process macros from std/prelude (brood-mode's list). Longer alternatives first so a prefix doesn't win.",
      "match": "(?<![\\w*?!<>=+./-])(if|when|unless|cond|do|let\\*?|letrec|fn|lambda|and|or|quote|quasiquote|binding|match\\*?|try|catch|throw|error|receive|dolist|doseq|dotimes|for|spawn-link|spawn|remote-spawn-sync|remote-spawn|with-out-str|bench)(?![\\w*?!<>=+./-])",
      "name": "keyword.control.brood"
    },
    "threading": {
      "comment": "The ->/->> threading macros (separate because they aren't word-char symbols).",
      "match": "(?<![\\w*?!<>=+./-])(->>|->)(?![\\w*?!<>=+./-])",
      "name": "keyword.control.brood"
    },
    "param-marker": {
      "comment": "Parameter-list markers: &optional and bare & (rest).",
      "match": "(?<=[\\s(\\[])&(optional)?(?=[\\s)\\]])",
      "name": "keyword.operator.brood"
    },
    "constant": {
      "match": "(?<![\\w*?!<>=+./-])(nil|true|false)(?![\\w*?!<>=+./-])",
      "name": "constant.language.brood"
    },
    "keyword": {
      "comment": "Brood keywords: :foo (self-evaluating, like Clojure).",
      "match": ":[^\\s()\\[\\]{}\",'`;]+",
      "name": "constant.keyword.brood"
    },
    "number": {
      "match": "(?<![\\w*?!<>=+./-])-?[0-9]+(\\.[0-9]+)?(?![\\w*?!<>=+./-])",
      "name": "constant.numeric.brood"
    }
  }
}
